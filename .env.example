# Copie este arquivo para .env e ajuste. Nunca coloque o .env no Git.

# mock = alertas simulados (para testar agora) | real = lê o Zabbix de verdade
ZABBIX_MODE=mock
ZABBIX_URL=https://seu-zabbix/api_jsonrpc.php
ZABBIX_TOKEN=
# bearer funciona no Zabbix 6.4 ou mais novo. Em versões anteriores use: param
ZABBIX_AUTH=bearer
# Use 0 se o Zabbix tiver certificado interno (autoassinado)
ZABBIX_VERIFY_TLS=1
# Gravidades lidas: 0 Not classified, 1 Information, 2 Warning, 3 Average, 4 High, 5 Disaster. Vazio = todas
ZABBIX_SEVERIDADES=3,4,5
# De quanto em quanto tempo o painel lê o Zabbix
POLL_SECONDS=15

# dry-run = só simula o envio (nada sai) | smtp = envia de verdade
EMAIL_MODE=dry-run
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASS=
# Conta do NOC (nunca e-mail pessoal)
SMTP_FROM=

# Login do painel (usuário e senha para abrir a página)
PAINEL_USUARIO=noc
PAINEL_SENHA=troque-esta-senha

TZ_NOC=America/Sao_Paulo
